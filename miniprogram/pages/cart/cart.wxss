.cart-list {
  padding-bottom: 140rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  margin: var(--space-sm);
  padding: var(--space-sm);
  background: var(--color-card);
  border-radius: var(--radius-md);
  position: relative;
}

.item-disabled {
  opacity: 0.55;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #c8c9cc;
  border-radius: 50%;
  margin-right: var(--space-sm);
  font-size: 24rpx;
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: var(--space-sm);
  min-width: 0;
}

.title {
  font-size: var(--font-body);
  color: var(--color-text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.warn {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--color-accent);
}

.foot {
  margin-top: var(--space-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.qty {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #e5e6eb;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--color-text);
}

.qty-num {
  min-width: 64rpx;
  text-align: center;
  font-size: var(--font-body);
  color: var(--color-text);
}

.del {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  font-size: var(--font-caption);
  color: #86909c;
  padding: 4rpx;
}

.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: var(--color-card);
  display: flex;
  align-items: center;
  padding: 0 var(--space-md);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.check.all {
  margin-right: 12rpx;
}

.all-label {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  margin-right: auto;
}

.total {
  font-size: var(--font-caption);
  color: var(--color-text);
  margin-right: var(--space-sm);
}

.total-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.settle-btn {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  font-size: var(--font-body);
}

.btn-disabled {
  opacity: 0.5;
}

.btn-go-home {
  margin: var(--space-md) auto 0;
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-caption);
}
