<view wx:if="{{!product}}" class="empty-box">加载中…</view>

<block wx:else>
  <view class="card row">
    <image class="row-cover" src="{{product.images[0] || product.coverImage}}" mode="aspectFill" />
    <view class="row-info">
      <view class="row-title">{{product.title}}</view>
      <view class="row-bottom">
        <view class="price-wrap">
          <text class="price-unit">¥</text>
          <text class="price-text price-sm">{{product.price.yuan}}</text>
          <text class="price-unit">.{{product.price.dec}}</text>
        </view>
        <text class="text-secondary">× {{quantity}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{product.type === 'physical'}}">
    <view class="card">
      <view class="sec-title">收货信息</view>
      <view class="form-row">
        <text class="form-label">收货人</text>
        <input class="form-input" placeholder="姓名" value="{{receiver.name}}"
          bindinput="onReceiverInput" data-key="name" />
      </view>
      <view class="form-row">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号"
          value="{{receiver.phone}}" bindinput="onReceiverInput" data-key="phone" />
      </view>
      <view class="form-row">
        <text class="form-label">省市区</text>
        <view class="form-3col">
          <input class="form-input" placeholder="省" value="{{receiver.province}}"
            bindinput="onReceiverInput" data-key="province" />
          <input class="form-input" placeholder="市" value="{{receiver.city}}"
            bindinput="onReceiverInput" data-key="city" />
          <input class="form-input" placeholder="区/县" value="{{receiver.district}}"
            bindinput="onReceiverInput" data-key="district" />
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">详细地址</text>
        <input class="form-input" placeholder="街道、门牌号" value="{{receiver.address}}"
          bindinput="onReceiverInput" data-key="address" />
      </view>
    </view>
  </block>

  <view wx:else class="card notice">
    <view class="sec-title">课程服务说明</view>
    <view class="text-secondary">支付成功后由工作人员与您联系核销；虚拟服务一经核销不可退款。</view>
  </view>

  <view class="foot-bar">
    <view class="total">
      <text class="text-secondary">合计</text>
      <text class="price-unit">¥</text>
      <text class="price-text">{{product.price.yuan}}</text>
      <text class="price-unit">.{{product.price.dec}}</text>
    </view>
    <view class="btn-primary foot-submit {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : '提交订单'}}
    </view>
  </view>
</block>
