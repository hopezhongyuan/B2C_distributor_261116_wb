.row {
  display: flex;
}

.row-cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background: var(--color-bg);
}

.row-info {
  flex: 1;
  margin-left: var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.row-title {
  font-size: var(--font-body);
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.row-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-sm {
  font-size: 34rpx;
}

.sec-title {
  font-size: var(--font-body);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.form-row {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
}

.form-input {
  flex: 1;
  font-size: var(--font-body);
}

.form-3col {
  flex: 1;
  display: flex;
  gap: var(--space-xs);
}

.form-3col .form-input {
  flex: 1;
  min-width: 0;
}

.notice {
  line-height: 1.6;
}

.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.total {
  display: flex;
  align-items: baseline;
}

.total .text-secondary {
  margin-right: var(--space-xs);
  align-self: center;
}

.foot-submit {
  width: 280rpx;
}
