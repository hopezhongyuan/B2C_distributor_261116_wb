<view class="page-head">
  <view class="page-title">精选课堂</view>
  <view class="page-slogan">好课好物，学习成长</view>
</view>

<view class="cate-nav">
  <view class="cate-item cate-blue" bindtap="goCategory" data-type="physical">
    <view class="cate-icon">📦</view>
    <view class="cate-name">好物商城</view>
  </view>
  <view class="cate-item cate-orange" bindtap="goCategory" data-type="virtual">
    <view class="cate-icon">🎓</view>
    <view class="cate-name">课程服务</view>
  </view>
  <view class="cate-item cate-green" bindtap="goCart">
    <view class="cate-icon">🛒</view>
    <view class="cate-name">购物车</view>
  </view>
  <view class="cate-item cate-purple" bindtap="goOrders">
    <view class="cate-icon">📋</view>
    <view class="cate-name">我的订单</view>
  </view>
</view>

<view wx:if="{{!loading && !error && products.length}}" class="section-title">推荐好物</view>

<view wx:if="{{loading}}" class="empty-box">加载中…</view>
<view wx:elif="{{error}}" class="empty-box">{{error}}
  <view class="btn-retry" bindtap="retry">重试</view>
</view>
<view wx:elif="{{products.length === 0}}" class="empty-box">暂无商品，敬请期待</view>

<view wx:else class="grid">
  <view class="grid-item" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <image class="cover" src="{{item.coverImage}}" mode="aspectFill" />
    <view class="item-title">{{item.title}}</view>
    <view class="item-foot">
      <view class="price-wrap">
        <text class="price-unit">¥</text>
        <text class="price-text">{{item.price.yuan}}</text>
        <text class="price-unit">.{{item.price.dec}}</text>
      </view>
      <text class="tag {{item.type === 'virtual' ? 'tag-orange' : 'tag-blue'}}">
        {{item.type === 'virtual' ? '课程服务' : '实物'}}
      </text>
    </view>
  </view>
</view>
