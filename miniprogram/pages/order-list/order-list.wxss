.filter {
  display: flex;
  background: var(--color-card);
  padding: var(--space-sm) var(--space-md);
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-item {
  margin-right: var(--space-md);
  padding: var(--space-xs) var(--space-md);
  border-radius: 999rpx;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.filter-item.active {
  color: #fff;
  background: var(--color-primary);
  font-weight: 500;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.status {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 500;
}

.order-body {
  display: flex;
  align-items: center;
}

.order-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  flex-shrink: 0;
}

.order-title {
  margin-left: var(--space-sm);
  font-size: var(--font-body);
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-foot {
  margin-top: var(--space-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-sm {
  font-size: 32rpx;
}

.btn-mini {
  min-width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--font-caption);
  padding: 0 var(--space-md);
}

.btn-mini.disabled {
  background: var(--color-disabled);
}

.btn-ghost {
  background: #fff;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: var(--space-lg);
}

.dialog-title {
  font-size: var(--font-title);
  font-weight: 600;
  text-align: center;
  margin-bottom: var(--space-md);
}

.field-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.field-label {
  width: 150rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.field-input {
  flex: 1;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: var(--font-body);
}

.dialog-btns {
  display: flex;
  margin-top: var(--space-lg);
}

.dialog-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: var(--font-body);
}

.dialog-btn.cancel {
  background: var(--color-bg);
  color: var(--color-text-secondary);
  margin-right: var(--space-md);
}

.dialog-btn.primary {
  background: var(--color-primary);
  color: #fff;
}
