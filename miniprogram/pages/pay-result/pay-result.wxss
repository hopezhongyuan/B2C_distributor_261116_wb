.result-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 0;
}

.result-icon {
  font-size: 100rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.result-desc {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  margin-top: 16rpx;
  text-align: center;
}

.result-amount {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-top: 24rpx;
}

.btn-primary {
  margin-top: 80rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: var(--font-body);
}

.btn-primary.disabled {
  opacity: 0.6;
}

.btn-plain {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  border-radius: 999rpx;
  font-size: var(--font-body);
}

.btn-plain.subtle {
  border: none;
  color: var(--color-text-secondary);
}

.error-text {
  color: #e34d59;
}
