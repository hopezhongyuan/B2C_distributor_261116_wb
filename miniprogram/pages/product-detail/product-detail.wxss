.hero {
  width: 100%;
  height: 560rpx;
  background: var(--color-bg);
  display: block;
}

.price-line {
  display: flex;
  align-items: baseline;
}

.tag {
  margin-left: var(--space-sm);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  align-self: center;
}

.tag-blue {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.tag-orange {
  color: var(--color-accent);
  background: var(--color-accent-light);
}

.title {
  margin-top: var(--space-sm);
  font-size: var(--font-subtitle);
  font-weight: 600;
  line-height: 1.4;
}

.sub {
  margin-top: var(--space-xs);
}

.sec-title {
  font-size: var(--font-body);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.detail {
  font-size: var(--font-body);
  line-height: 1.7;
  color: var(--color-text);
  white-space: pre-wrap;
}

.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  display: flex;
  align-items: center;
  padding: var(--space-sm) var(--space-md) calc(var(--space-sm) + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.share-btn {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-caption);
  border-radius: var(--radius-md);
}

.qty {
  display: flex;
  align-items: center;
  margin-left: var(--space-sm);
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  font-size: 32rpx;
}

.qty-num {
  width: 72rpx;
  text-align: center;
  font-size: var(--font-body);
}

.cart-add {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-left: var(--space-sm);
  background: var(--color-accent-light);
  color: var(--color-accent);
  border-radius: var(--radius-md);
  font-size: var(--font-caption);
  flex-shrink: 0;
}

.foot-buy {
  flex: 1;
  margin-left: var(--space-md);
}

.spec-row {
  display: flex;
  margin-top: 16rpx;
}

.spec-label {
  width: 90rpx;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  padding-top: 8rpx;
}

.spec-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-tag {
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-border);
  font-size: var(--font-caption);
  color: var(--color-text);
}

.spec-tag.active {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: rgba(46, 107, 230, 0.06);
}
