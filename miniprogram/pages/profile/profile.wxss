.head {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.head-info {
  flex: 1;
  margin-left: var(--space-md);
}

.head-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-body);
}

.btn-mini {
  min-width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-caption);
  padding: 0 var(--space-md);
}

.contact-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  line-height: inherit;
  font-weight: normal;
}

.contact-btn::after {
  border: none;
}
