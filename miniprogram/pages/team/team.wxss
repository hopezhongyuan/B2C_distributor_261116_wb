/* 我的团队页 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
}

.head {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}
.head-cell {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 12rpx;
}
.head-active {
  background: #E8F3FF;
}
.head-num { font-size: 40rpx; font-weight: 700; color: #1D2129; }
.head-active .head-num { color: #2E6BE6; }
.head-label { font-size: 24rpx; color: #86909C; margin-top: 6rpx; }
.head-divider { width: 1rpx; height: 56rpx; background: #E5E6EB; }

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
}
.state-err {
  color: #86909C;
  margin-bottom: 24rpx;
}
.btn-retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: #2E6BE6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.member {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
  padding: 24rpx 28rpx;
}
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #2E6BE6;
  color: #fff;
  font-size: 32rpx;
  text-align: center;
  line-height: 76rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.member-main { flex: 1; min-width: 0; }
.member-name {
  font-size: 28rpx;
  color: #1D2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-sub { font-size: 22rpx; margin-top: 8rpx; }
.member-right { text-align: right; }
.member-amount { font-size: 30rpx; font-weight: 600; color: #FF8F1F; }
.member-label { font-size: 20rpx; margin-top: 4rpx; }
