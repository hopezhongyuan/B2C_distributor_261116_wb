/* 提现页 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin: 8rpx 0 20rpx;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
}
.state-err { color: #86909C; margin-bottom: 24rpx; }
.btn-retry {
  display: inline-block;
  padding: 12rpx 48rpx;
  background: #2E6BE6;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.hero {
  background: linear-gradient(135deg, #2E6BE6, #5A8DF0);
  color: #fff;
  text-align: center;
  padding: 40rpx 28rpx 32rpx;
}
.hero-label { font-size: 26rpx; opacity: 0.85; }
.hero-amount { font-size: 60rpx; font-weight: 700; margin: 12rpx 0; }
.hero-tip { font-size: 22rpx; opacity: 0.85; }

.amount-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #E5E6EB;
  padding-bottom: 16rpx;
}
.yen { font-size: 44rpx; font-weight: 600; color: #1D2129; margin-right: 12rpx; }
.amount-input { flex: 1; font-size: 40rpx; }
.btn-all {
  padding: 8rpx 24rpx;
  background: #E8F3FF;
  color: #2E6BE6;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #F2F3F5;
  padding: 20rpx 0;
}
.form-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #4E5969;
  flex-shrink: 0;
}
.form-input { flex: 1; font-size: 28rpx; }
.realname-tip { font-size: 24rpx; margin: 8rpx 0 4rpx; }
.privacy-tip { font-size: 20rpx; margin-top: 12rpx; }
.pending-tip { font-size: 22rpx; text-align: center; margin-top: 16rpx; }

.btn-submit {
  margin-top: 32rpx;
  background: #FF8F1F;
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border-radius: 999rpx;
}
.btn-submit.disabled { opacity: 0.6; }

.rec {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F7F8FA;
}
.rec:last-child { border-bottom: none; }
.rec-title { font-size: 26rpx; color: #1D2129; }
.rec-sub { font-size: 22rpx; margin-top: 6rpx; }
.rec-amount { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.empty { text-align: center; padding: 32rpx 0; font-size: 24rpx; }
